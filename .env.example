# --- Database ---
# PostgreSQL connection string (required for Vercel/Production)
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# --- AWS Cognito (Auth) ---
AWS_REGION="us-east-1"
COGNITO_USER_POOL_ID="us-east-1_xxxxxxxxx"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Frontend ---
VUE_APP_API_URL="/api/v1"
VUE_APP_GOOGLE_MAPS_API_KEY="your_google_maps_key"

# --- Stripe ---
STRIPE_MODE="test"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret — different per environment:
#   Dev:  run `npm run stripe:listen` and paste the printed whsec_... here (webhooks hit localhost)
#   Live: Stripe Dashboard → Webhooks → add endpoint https://your-app.vercel.app/api/v1/stripe/webhook → use that signing secret in Vercel env
STRIPE_WEBHOOK_SECRET="whsec_..."
APP_URL="https://your-domain.com"
# Primary public URL for this environment — used as the base for Stripe redirect
# and email links. Set per Vercel environment:
#   prod:    https://couponbook.vercel.app (or your custom domain)
#   preview: leave unset — VERCEL_URL fallback kicks in automatically
#   dev:     http://localhost:8080
APP_PUBLIC_URL="https://couponbook.vercel.app"
# Comma-separated list of allowed Origin headers for checkout initiation.
# Supports exact origins and wildcard subdomain patterns (e.g. https://*.vercel.app).
# Set once for all Vercel environments.
ALLOWED_APP_ORIGINS="https://couponbook.vercel.app,https://*.vercel.app,http://localhost:8080"

# --- Promo Code Unlock (optional, feature-flagged) ---
# Set TRIAL_PROMO_ENABLED=true to enable the /promo-unlock endpoint in any environment.
# Feature is off by default when vars are absent.
TRIAL_PROMO_ENABLED=false
TRIAL_PROMO_CODE=

# --- Transactional email requests (n8n) ---
# Cron/webhooks decide when emails are needed; n8n sends the actual email.
N8N_NOTIFICATION_WEBHOOK_URL=""
# Optional paid-events-specific override. Falls back to N8N_NOTIFICATION_WEBHOOK_URL.
PAID_EVENT_NOTIFICATION_WEBHOOK_URL=""

# --- Cron Secret ---
# Random secret used to authenticate Vercel cron job calls. Canonical path is
#   /api/v1/cron/renewal-reminders
# (a legacy alias at /api/v1/admin/cron/renewal-reminders is also accepted).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Subscription Migration ---
# Number of days to extend access for existing purchases during the one-time migration.
# Only used by scripts/migrate-existing-purchases.js. Default: 365
ACCESS_MIGRATION_GRACE_DAYS=365
