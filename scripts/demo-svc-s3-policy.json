{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCouponbookAppUploads",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::couponbook-images/logos/merchants/*",
        "arn:aws:s3:::couponbook-images/backgrounds/merchants/*",
        "arn:aws:s3:::couponbook-images/events/submissions/*"
      ]
    }
  ]
}
